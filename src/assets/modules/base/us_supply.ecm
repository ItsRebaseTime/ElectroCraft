{
  "format": "electrocraft-modules",
  "version": 1,
  "modules": [
    {
      "id": "us_supply",
      "name": "Utility service (US)",
      "description": "Service entrance: split-phase 120/240 V or three-phase 208Y/120 V, with neutral and ground.",
      "designation": "G",
      "device": {
        "category": "sources",
        "role": "source",
        "icon": "gridsupply",
        "mount": "free",
        "region": "us",
        "poleMode": "none",
        "params": [
          {
            "key": "phases",
            "label": "Service",
            "type": "select",
            "options": [
              {
                "value": 2,
                "label": "Split-phase 120/240 V"
              },
              {
                "value": 3,
                "label": "3-phase 208Y/120 V"
              }
            ],
            "default": 2,
            "group": "config"
          },
          {
            "key": "In",
            "label": "Service size",
            "type": "select",
            "options": [
              {
                "value": 100,
                "label": "100 A"
              },
              {
                "value": 125,
                "label": "125 A"
              },
              {
                "value": 150,
                "label": "150 A"
              },
              {
                "value": 200,
                "label": "200 A"
              },
              {
                "value": 225,
                "label": "225 A"
              },
              {
                "value": 400,
                "label": "400 A"
              }
            ],
            "default": 200,
            "group": "rating"
          },
          {
            "key": "Un",
            "label": "Voltage (L-N)",
            "type": "select",
            "options": [
              120
            ],
            "default": 120,
            "unit": "V",
            "group": "rating"
          },
          {
            "key": "feeder",
            "label": "Service conductors",
            "type": "text",
            "default": "2/0 AWG",
            "group": "config"
          }
        ],
        "stateful": true,
        "summary": "{In}A",
        "svg": [
          "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 110 74\" width=\"110\" height=\"74\">",
          "  <!--",
          "    Layer conventions (see docs/equipment-assets.md):",
          "      data-scope=\"pole\"    drawn once per pole, tile is the viewBox",
          "      data-scope=\"device\"  drawn once (default)",
          "      data-stretch=\"x\"     device layer scaled horizontally over all poles (use fills only)",
          "      data-show=\"...\"      visibility expression, e.g. on,!tripped  pole-n  kind==lamp",
          "      data-center-x=\"true\" text centred across the whole device",
          "      data-terminal=\"...\"  connection point (top/bottom per pole, or a name for device terminals)",
          "      {{token}}            replaced by parameters, e.g. {{In}} {{curve}} {{Icn#label}} {{color#hex}}",
          "  -->",
          "  <g data-layer=\"body\">",
          "    <rect x=\"0.5\" y=\"0.5\" width=\"109\" height=\"62\" rx=\"3\" fill=\"#e9eef5\" stroke=\"#4c5a6b\" stroke-width=\"0.8\"/>",
          "    <rect x=\"0.5\" y=\"0.5\" width=\"109\" height=\"18\" rx=\"3\" fill=\"#33465c\"/>",
          "    <path d=\"M12 4.5 7 11h3.2L9 15.8 15 8.6h-3.4z\" fill=\"#fde047\"/>",
          "    <text x=\"22\" y=\"13\" font-size=\"6\" fill=\"#ffffff\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">UTILITY SERVICE</text>",
          "    <text x=\"104\" y=\"13\" font-size=\"4.2\" fill=\"#d7e0ea\" text-anchor=\"end\" font-family=\"Helvetica, Arial, sans-serif\">{{phases#label}}</text>",
          "    <text x=\"55\" y=\"31\" font-size=\"4\" fill=\"#4c5a6b\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">{{In}} A service  -  {{feeder}}</text>",
          "  </g>",
          "  <g data-show=\"true\">",
          "    <circle data-terminal=\"L1\" data-dir=\"down\" cx=\"20\" cy=\"66\" r=\"3.4\" fill=\"#23272d\" stroke=\"#2a3138\" stroke-width=\"0.6\"/>",
          "    <text x=\"20\" y=\"58.5\" font-size=\"3.4\" text-anchor=\"middle\" fill=\"#2a3138\" font-family=\"Helvetica, Arial, sans-serif\">L1</text>",
          "    <circle cx=\"20\" cy=\"50\" r=\"2\" fill=\"#2e9e44\" data-show=\"on\"/>",
          "    <circle cx=\"20\" cy=\"50\" r=\"2\" fill=\"#2e9e44\" fill-opacity=\"0.25\" data-show=\"!on\"/>",
          "  </g>",
          "  <g data-show=\"phases>=2\">",
          "    <circle data-terminal=\"L2\" data-dir=\"down\" cx=\"38\" cy=\"66\" r=\"3.4\" fill=\"#d1342f\" stroke=\"#2a3138\" stroke-width=\"0.6\"/>",
          "    <text x=\"38\" y=\"58.5\" font-size=\"3.4\" text-anchor=\"middle\" fill=\"#2a3138\" font-family=\"Helvetica, Arial, sans-serif\">L2</text>",
          "    <circle cx=\"38\" cy=\"50\" r=\"2\" fill=\"#2e9e44\" data-show=\"on\"/>",
          "    <circle cx=\"38\" cy=\"50\" r=\"2\" fill=\"#2e9e44\" fill-opacity=\"0.25\" data-show=\"!on\"/>",
          "  </g>",
          "  <g data-show=\"phases>=3\">",
          "    <circle data-terminal=\"L3\" data-dir=\"down\" cx=\"56\" cy=\"66\" r=\"3.4\" fill=\"#1f6fd1\" stroke=\"#2a3138\" stroke-width=\"0.6\"/>",
          "    <text x=\"56\" y=\"58.5\" font-size=\"3.4\" text-anchor=\"middle\" fill=\"#2a3138\" font-family=\"Helvetica, Arial, sans-serif\">L3</text>",
          "    <circle cx=\"56\" cy=\"50\" r=\"2\" fill=\"#2e9e44\" data-show=\"on\"/>",
          "    <circle cx=\"56\" cy=\"50\" r=\"2\" fill=\"#2e9e44\" fill-opacity=\"0.25\" data-show=\"!on\"/>",
          "  </g>",
          "  <g data-show=\"true\">",
          "    <circle data-terminal=\"N\" data-dir=\"down\" cx=\"74\" cy=\"66\" r=\"3.4\" fill=\"#f1f1f1\" stroke=\"#2a3138\" stroke-width=\"0.6\"/>",
          "    <text x=\"74\" y=\"58.5\" font-size=\"3.4\" text-anchor=\"middle\" fill=\"#2a3138\" font-family=\"Helvetica, Arial, sans-serif\">N</text>",
          "    <circle cx=\"74\" cy=\"50\" r=\"2\" fill=\"#2e9e44\" data-show=\"on\"/>",
          "    <circle cx=\"74\" cy=\"50\" r=\"2\" fill=\"#2e9e44\" fill-opacity=\"0.25\" data-show=\"!on\"/>",
          "  </g>",
          "  <g data-show=\"true\">",
          "    <circle data-terminal=\"PE\" data-dir=\"down\" cx=\"92\" cy=\"66\" r=\"3.4\" fill=\"#2e9e44\" stroke=\"#2a3138\" stroke-width=\"0.6\"/>",
          "    <text x=\"92\" y=\"58.5\" font-size=\"3.4\" text-anchor=\"middle\" fill=\"#2a3138\" font-family=\"Helvetica, Arial, sans-serif\">PE</text>",
          "    <circle cx=\"92\" cy=\"50\" r=\"2\" fill=\"#2e9e44\" data-show=\"on\"/>",
          "    <circle cx=\"92\" cy=\"50\" r=\"2\" fill=\"#2e9e44\" fill-opacity=\"0.25\" data-show=\"!on\"/>",
          "  </g>",
          "</svg>"
        ]
      }
    }
  ]
}
