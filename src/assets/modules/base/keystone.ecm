{
  "format": "electrocraft-modules",
  "version": 1,
  "modules": [
    {
      "id": "keystone",
      "name": "Keystone patch panel",
      "description": "A grid of keystone jacks along the top or bottom of a panel section. Choose rows and columns; wire the network cables from the floor plan to the jacks.",
      "designation": "XP",
      "device": {
        "category": "connection",
        "role": "patch",
        "icon": "terminal",
        "mount": "din",
        "hidden": true,
        "poleMode": "none",
        "params": [
          {
            "key": "rows",
            "label": "Rows",
            "type": "number",
            "default": 2,
            "min": 1,
            "max": 4,
            "step": 1,
            "group": "config"
          },
          {
            "key": "cols",
            "label": "Columns",
            "type": "number",
            "default": 12,
            "min": 1,
            "max": 24,
            "step": 1,
            "group": "config"
          }
        ],
        "summary": "{rows} x {cols}",
