{
  "format": "electrocraft-modules",
  "version": 1,
  "modules": [
    {
      "id": "spd",
      "name": "Surge protection (SPD)",
      "description": "Surge protective device, types 1/2/3.",
      "designation": "F",
      "device": {
        "category": "protection",
        "role": "protection",
        "icon": "spd",
        "mount": "din",
        "poleMode": "config",
        "poleConfigs": [
          "1P+N",
          "1P",
          "2P",
          "3P",
          "3P+N"
        ],
        "params": [
          {
            "key": "type",
            "label": "Type",
            "type": "select",
            "options": [
              "1",
              "2",
              "3",
              "1+2",
              "2+3"
            ],
            "default": "2",
            "group": "rating"
          },
          {
            "key": "Uc",
            "label": "Max. continuous voltage Uc",
            "type": "select",
            "options": [
              275,
              320,
              385,
              440
            ],
            "default": 275,
            "unit": "V",
            "group": "rating"
          },
          {
            "key": "Imax",
            "label": "Max. discharge current",
            "type": "select",
            "options": [
              20,
              40,
              50,
              65
            ],
            "default": 40,
            "unit": "kA",
            "group": "rating"
          }
        ],
        "summary": "SPD T{type}",
        "svg": [
          "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 18 90\" width=\"18\" height=\"90\">",
          "  <!--",
          "    Layer conventions (see docs/equipment-assets.md):",
          "      data-scope=\"pole\"    drawn once per pole, tile is the viewBox",
          "      data-scope=\"device\"  drawn once (default)",
          "      data-stretch=\"x\"     device layer scaled horizontally over all poles (use fills only)",
          "      data-show=\"...\"      visibility expression, e.g. on,!tripped  pole-n  kind==lamp",
          "      data-center-x=\"true\" text centred across the whole device",
          "      data-terminal=\"...\"  connection point (top/bottom per pole, or a name for device terminals)",
          "      {{token}}            replaced by parameters, e.g. {{In}} {{curve}} {{Icn#label}} {{color#hex}}",
          "  -->",
          "  <g data-scope=\"pole\" data-layer=\"frame-single\" data-show=\"pole-first,pole-last\"><rect x=\"0.3\" y=\"0.3\" width=\"17.4\" height=\"89.4\" rx=\"1.6\" fill=\"#e8e6f0\" stroke=\"#69747f\" stroke-width=\"0.6\"/><rect x=\"1.6\" y=\"1.6\" width=\"14.8\" height=\"12\" rx=\"1\" fill=\"#d4d0e2\"/><rect x=\"1.6\" y=\"76.4\" width=\"14.8\" height=\"12\" rx=\"1\" fill=\"#d4d0e2\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"frame-first\" data-show=\"pole-first,!pole-last\"><path d=\"M18 0.3H1.9A1.6 1.6 0 0 0 0.3 1.9V88.1A1.6 1.6 0 0 0 1.9 89.7H18Z\" fill=\"#e8e6f0\"/><rect x=\"1.6\" y=\"1.6\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#d4d0e2\"/><rect x=\"1.6\" y=\"76.4\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#d4d0e2\"/><path d=\"M18 0.3H1.9A1.6 1.6 0 0 0 0.3 1.9V88.1A1.6 1.6 0 0 0 1.9 89.7H18\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"frame-middle\" data-show=\"!pole-first,!pole-last\"><rect x=\"0\" y=\"0.3\" width=\"18\" height=\"89.4\" fill=\"#e8e6f0\"/><rect x=\"-1\" y=\"1.6\" width=\"20\" height=\"12\" rx=\"1\" fill=\"#d4d0e2\"/><rect x=\"-1\" y=\"76.4\" width=\"20\" height=\"12\" rx=\"1\" fill=\"#d4d0e2\"/><path d=\"M0 0.3H18M0 89.7H18\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"frame-last\" data-show=\"!pole-first,pole-last\"><path d=\"M0 0.3H16.1A1.6 1.6 0 0 1 17.7 1.9V88.1A1.6 1.6 0 0 1 16.1 89.7H0Z\" fill=\"#e8e6f0\"/><rect x=\"-1\" y=\"1.6\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#d4d0e2\"/><rect x=\"-1\" y=\"76.4\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#d4d0e2\"/><path d=\"M0 0.3H16.1A1.6 1.6 0 0 1 17.7 1.9V88.1A1.6 1.6 0 0 1 16.1 89.7H0\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"body\">",
          "    <circle data-terminal=\"top\" cx=\"9\" cy=\"7.6\" r=\"3\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M7.2 7.6h3.5999999999999996\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "    <circle data-terminal=\"bottom\" cx=\"9\" cy=\"82.4\" r=\"3\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M7.2 82.4h3.5999999999999996\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "  </g>",
          "  <g data-scope=\"pole\" data-layer=\"neutral-tag\" data-show=\"pole-n\">",
          "    <rect x=\"1.6\" y=\"15\" width=\"14.8\" height=\"4\" rx=\"0.8\" fill=\"#1f6fd1\"/>",
          "    <text x=\"9\" y=\"18\" font-size=\"3.2\" fill=\"#ffffff\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">N</text>",
          "  </g>",
          "  <g data-layer=\"label-plate\" data-stretch=\"x\"><rect x=\"1.8\" y=\"20\" width=\"14.4\" height=\"54\" fill=\"#e8e6f0\"/></g>",
          "  <g data-layer=\"status-ok\" data-stretch=\"x\" data-show=\"!tripped\"><rect x=\"3\" y=\"33\" width=\"12\" height=\"7\" rx=\"1\" fill=\"#2e9e44\"/></g>",
          "  <g data-layer=\"status-bad\" data-stretch=\"x\" data-show=\"tripped\"><rect x=\"3\" y=\"33\" width=\"12\" height=\"7\" rx=\"1\" fill=\"#d1342f\"/></g>",
          "  <g data-layer=\"labels\">",
          "    <text data-center-x=\"true\" x=\"0\" y=\"25\" font-size=\"4.2\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">SPD T{{type}}</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"50\" font-size=\"3.2\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">Uc {{Uc}} V</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"55\" font-size=\"3.2\" fill=\"#59636e\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">Imax {{Imax}} kA</text>",
          "  </g>",
          "</svg>"
        ]
      }
    }
  ]
}
