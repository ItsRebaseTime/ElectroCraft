{
  "format": "electrocraft-modules",
  "version": 1,
  "modules": [
    {
      "id": "contactor",
      "name": "Contactor",
      "description": "Modular contactor. Switched by hand in this planner (coil wiring is not simulated).",
      "designation": "K",
      "device": {
        "category": "switching",
        "role": "switch",
        "icon": "contactor",
        "mount": "din",
        "poleMode": "config",
        "poleConfigs": [
          "2P",
          "3P",
          "3P+N"
        ],
        "params": [
          {
            "key": "In",
            "label": "Rated current",
            "type": "select",
            "options": [
              {
                "value": 16,
                "label": "16 A"
              },
              {
                "value": 20,
                "label": "20 A"
              },
              {
                "value": 25,
                "label": "25 A"
              },
              {
                "value": 40,
                "label": "40 A"
              },
              {
                "value": 63,
                "label": "63 A"
              }
            ],
            "default": 25,
            "group": "rating"
          },
          {
            "key": "cat",
            "label": "Utilisation category",
            "type": "select",
            "options": [
              "AC-1",
              "AC-3",
              "AC-7a"
            ],
            "default": "AC-1",
            "group": "rating"
          },
          {
            "key": "Uc",
            "label": "Coil voltage",
            "type": "select",
            "options": [
              {
                "value": 24,
                "label": "24 V"
              },
              {
                "value": 230,
                "label": "230 V"
              }
            ],
            "default": 230,
            "unit": "V",
            "group": "rating"
          },
          {
            "key": "Un",
            "label": "Rated voltage",
            "type": "select",
            "options": [
              400,
              230
            ],
            "default": 400,
            "unit": "V",
            "group": "rating"
          }
        ],
        "stateful": true,
        "summary": "{In}A {cat}",
        "svg": [
          "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 18 90\" width=\"18\" height=\"90\">",
          "  <!--",
          "    Layer conventions (see docs/equipment-assets.md):",
          "      data-scope=\"pole\"    drawn once per pole, tile is the viewBox",
          "      data-scope=\"device\"  drawn once (default)",
          "      data-stretch=\"x\"     device layer scaled horizontally over all poles (use fills only)",
          "      data-show=\"...\"      visibility expression, e.g. on,!tripped  pole-n  kind==lamp",
          "      data-center-x=\"true\" text centred across the whole device",
          "      data-terminal=\"...\"  connection point (top/bottom per pole, or a name for device terminals)",
          "      {{token}}            replaced by parameters, e.g. {{In}} {{curve}} {{Icn#label}} {{color#hex}}",
          "  -->",
          "  <g data-scope=\"pole\" data-layer=\"frame-single\" data-show=\"pole-first,pole-last\"><rect x=\"0.3\" y=\"0.3\" width=\"17.4\" height=\"89.4\" rx=\"1.6\" fill=\"#e4e7ea\" stroke=\"#69747f\" stroke-width=\"0.6\"/><rect x=\"1.6\" y=\"1.6\" width=\"14.8\" height=\"12\" rx=\"1\" fill=\"#cfd5db\"/><rect x=\"1.6\" y=\"76.4\" width=\"14.8\" height=\"12\" rx=\"1\" fill=\"#cfd5db\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"frame-first\" data-show=\"pole-first,!pole-last\"><path d=\"M18 0.3H1.9A1.6 1.6 0 0 0 0.3 1.9V88.1A1.6 1.6 0 0 0 1.9 89.7H18Z\" fill=\"#e4e7ea\"/><rect x=\"1.6\" y=\"1.6\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#cfd5db\"/><rect x=\"1.6\" y=\"76.4\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#cfd5db\"/><path d=\"M18 0.3H1.9A1.6 1.6 0 0 0 0.3 1.9V88.1A1.6 1.6 0 0 0 1.9 89.7H18\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"frame-middle\" data-show=\"!pole-first,!pole-last\"><rect x=\"0\" y=\"0.3\" width=\"18\" height=\"89.4\" fill=\"#e4e7ea\"/><rect x=\"-1\" y=\"1.6\" width=\"20\" height=\"12\" rx=\"1\" fill=\"#cfd5db\"/><rect x=\"-1\" y=\"76.4\" width=\"20\" height=\"12\" rx=\"1\" fill=\"#cfd5db\"/><path d=\"M0 0.3H18M0 89.7H18\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"frame-last\" data-show=\"!pole-first,pole-last\"><path d=\"M0 0.3H16.1A1.6 1.6 0 0 1 17.7 1.9V88.1A1.6 1.6 0 0 1 16.1 89.7H0Z\" fill=\"#e4e7ea\"/><rect x=\"-1\" y=\"1.6\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#cfd5db\"/><rect x=\"-1\" y=\"76.4\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#cfd5db\"/><path d=\"M0 0.3H16.1A1.6 1.6 0 0 1 17.7 1.9V88.1A1.6 1.6 0 0 1 16.1 89.7H0\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"body\">",
          "    <circle data-terminal=\"top\" cx=\"9\" cy=\"7.6\" r=\"3\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M7.2 7.6h3.5999999999999996\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "    <circle data-terminal=\"bottom\" cx=\"9\" cy=\"82.4\" r=\"3\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M7.2 82.4h3.5999999999999996\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "  </g>",
          "  <g data-scope=\"pole\" data-layer=\"neutral-tag\" data-show=\"pole-n\">",
          "    <rect x=\"1.6\" y=\"15\" width=\"14.8\" height=\"4\" rx=\"0.8\" fill=\"#1f6fd1\"/>",
          "    <text x=\"9\" y=\"18\" font-size=\"3.2\" fill=\"#ffffff\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">N</text>",
          "  </g>",
          "  <g data-layer=\"label-plate\" data-stretch=\"x\"><rect x=\"1.8\" y=\"20\" width=\"14.4\" height=\"54\" fill=\"#e4e7ea\"/></g>",
          "  <g data-layer=\"coil-plate\" data-stretch=\"x\"><rect x=\"1.8\" y=\"30\" width=\"14.4\" height=\"30\" rx=\"1\" fill=\"#b9c1ca\"/></g>",
          "  <g data-layer=\"armature-on\" data-stretch=\"x\" data-show=\"on\"><rect x=\"3\" y=\"31.5\" width=\"12\" height=\"8\" rx=\"1\" fill=\"#2e9e44\"/></g>",
          "  <g data-layer=\"armature-off\" data-stretch=\"x\" data-show=\"!on\"><rect x=\"3\" y=\"50.5\" width=\"12\" height=\"8\" rx=\"1\" fill=\"#5b6672\"/></g>",
          "  <g data-layer=\"labels\">",
          "    <text data-center-x=\"true\" x=\"0\" y=\"24\" font-size=\"4\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">{{In}}A {{cat}}</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"66\" font-size=\"3.2\" fill=\"#59636e\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">A1/A2 {{Uc}} V</text>",
          "  </g>",
          "</svg>"
        ]
      }
    }
  ]
}
