{
  "format": "electrocraft-modules",
  "version": 1,
  "modules": [
    {
      "id": "rcd",
      "name": "Residual current device (RCD)",
      "description": "Earth-leakage protection, 2 or 4 poles, types AC/A/F/B.",
      "designation": "F",
      "device": {
        "category": "protection",
        "role": "protection",
        "icon": "rcd",
        "mount": "din",
        "poleMode": "config",
        "poleConfigs": [
          "2P",
          "4P"
        ],
        "params": [
          {
            "key": "In",
            "label": "Rated current",
            "type": "select",
            "options": [
              {
                "value": 16,
                "label": "16 A"
              },
              {
                "value": 25,
                "label": "25 A"
              },
              {
                "value": 40,
                "label": "40 A"
              },
              {
                "value": 63,
                "label": "63 A"
              },
              {
                "value": 80,
                "label": "80 A"
              },
              {
                "value": 100,
                "label": "100 A"
              }
            ],
            "default": 40,
            "group": "rating"
          },
          {
            "key": "IdN",
            "label": "Sensitivity",
            "type": "select",
            "options": [
              {
                "value": 10,
                "label": "10 mA"
              },
              {
                "value": 30,
                "label": "30 mA"
              },
              {
                "value": 100,
                "label": "100 mA"
              },
              {
                "value": 300,
                "label": "300 mA"
              },
              {
                "value": 500,
                "label": "500 mA"
              }
            ],
            "default": 30,
            "group": "rating"
          },
          {
            "key": "type",
            "label": "Type",
            "type": "select",
            "options": [
              "AC",
              "A",
              "F",
              "B"
            ],
            "default": "A",
            "group": "rating"
          },
          {
            "key": "Un",
            "label": "Rated voltage",
            "type": "select",
            "options": [
              230,
              400
            ],
            "default": 230,
            "unit": "V",
            "group": "rating"
          }
        ],
        "stateful": true,
        "tripsOnOverload": true,
        "summary": "{In}A/{IdN}mA {type}",
        "svg": [
          "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 18 90\" width=\"18\" height=\"90\">",
          "  <!--",
          "    Layer conventions (see docs/equipment-assets.md):",
          "      data-scope=\"pole\"    drawn once per pole, tile is the viewBox",
          "      data-scope=\"device\"  drawn once (default)",
          "      data-stretch=\"x\"     device layer scaled horizontally over all poles (use fills only)",
          "      data-show=\"...\"      visibility expression, e.g. on,!tripped  pole-n  kind==lamp",
          "      data-center-x=\"true\" text centred across the whole device",
          "      data-terminal=\"...\"  connection point (top/bottom per pole, or a name for device terminals)",
          "      {{token}}            replaced by parameters, e.g. {{In}} {{curve}} {{Icn#label}} {{color#hex}}",
          "  -->",
          "  <g data-scope=\"pole\" data-layer=\"body\">",
          "    <rect x=\"0.3\" y=\"0.3\" width=\"17.4\" height=\"89.4\" rx=\"1.6\" fill=\"#e7edf5\" stroke=\"#69747f\" stroke-width=\"0.6\"/>",
          "    <rect x=\"1.6\" y=\"1.6\" width=\"14.8\" height=\"12\" rx=\"1\" fill=\"#d3d9e0\"/>",
          "    <rect x=\"1.6\" y=\"76.4\" width=\"14.8\" height=\"12\" rx=\"1\" fill=\"#d3d9e0\"/>",
          "    <circle data-terminal=\"top\" cx=\"9\" cy=\"7.6\" r=\"3\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M7.2 7.6h3.5999999999999996\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "    <circle data-terminal=\"bottom\" cx=\"9\" cy=\"82.4\" r=\"3\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M7.2 82.4h3.5999999999999996\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "  </g>",
          "  <g data-scope=\"pole\" data-layer=\"neutral-tag\" data-show=\"pole-n\">",
          "    <rect x=\"1.6\" y=\"15\" width=\"14.8\" height=\"4\" rx=\"0.8\" fill=\"#1f6fd1\"/>",
          "    <text x=\"9\" y=\"18\" font-size=\"3.2\" fill=\"#ffffff\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">N</text>",
          "  </g>",
          "  <g data-layer=\"label-plate\" data-stretch=\"x\"><rect x=\"1.8\" y=\"20\" width=\"14.4\" height=\"54\" fill=\"#e7edf5\"/></g>",
          "  <g data-layer=\"window\" data-stretch=\"x\"><rect x=\"1.8\" y=\"33\" width=\"14.4\" height=\"25\" rx=\"1.2\" fill=\"#c9d0d8\"/></g>",
          "  <g data-layer=\"lever-on\" data-stretch=\"x\" data-show=\"on,!tripped\"><rect x=\"3\" y=\"34.5\" width=\"12\" height=\"11.5\" rx=\"1\" fill=\"#2d343c\"/><rect x=\"3\" y=\"34.5\" width=\"12\" height=\"2\" rx=\"1\" fill=\"#5b6672\"/></g>",
          "  <g data-layer=\"lever-off\" data-stretch=\"x\" data-show=\"!on,!tripped\"><rect x=\"3\" y=\"45\" width=\"12\" height=\"11.5\" rx=\"1\" fill=\"#2d343c\"/><rect x=\"3\" y=\"54.5\" width=\"12\" height=\"2\" rx=\"1\" fill=\"#5b6672\"/></g>",
          "  <g data-layer=\"lever-tripped\" data-stretch=\"x\" data-show=\"tripped\"><rect x=\"3\" y=\"39.8\" width=\"12\" height=\"11.5\" rx=\"1\" fill=\"#2d343c\"/><rect x=\"3\" y=\"55\" width=\"12\" height=\"2\" fill=\"#f08a24\"/></g>",
          "  <g data-layer=\"labels\">",
          "    <text data-center-x=\"true\" x=\"0\" y=\"25\" font-size=\"4.6\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">{{In}}A</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"30\" font-size=\"3.6\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">{{IdN}} mA</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"63\" font-size=\"3.2\" fill=\"#59636e\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">Type {{type}}</text>",
          "  </g>",
          "  <g data-layer=\"test-button\"><rect x=\"3.5\" y=\"70\" width=\"11\" height=\"4.2\" rx=\"1\" fill=\"#1f6fd1\"/><text x=\"9\" y=\"73.2\" font-size=\"2.8\" fill=\"#fff\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">T</text></g>",
          "</svg>"
        ]
      }
    }
  ]
}
