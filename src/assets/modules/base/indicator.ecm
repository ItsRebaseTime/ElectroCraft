{
  "format": "electrocraft-modules",
  "version": 1,
  "modules": [
    {
      "id": "indicator",
      "name": "Pilot light",
      "description": "Indicator lamp per phase. Lights when its top terminal is on a live phase and the bottom terminal is on neutral.",
      "designation": "H",
      "device": {
        "category": "indication",
        "role": "indicator",
        "icon": "lamp",
        "mount": "din",
        "poleMode": "config",
        "poleConfigs": [
          "1P",
          "2P",
          "3P"
        ],
        "params": [
          {
            "key": "color",
            "label": "Lens colour",
            "type": "select",
            "options": [
              {
                "value": "green",
                "label": "Green",
                "hex": "#2fbf4f"
              },
              {
                "value": "red",
                "label": "Red",
                "hex": "#e53935"
              },
              {
                "value": "yellow",
                "label": "Yellow",
                "hex": "#f5c400"
              },
              {
                "value": "blue",
                "label": "Blue",
                "hex": "#1e6fe0"
              },
              {
                "value": "white",
                "label": "White",
                "hex": "#f4f4f4"
              }
            ],
            "default": "green"
          },
          {
            "key": "Un",
            "label": "Rated voltage",
            "type": "select",
            "options": [
              230,
              400
            ],
            "default": 230,
            "unit": "V",
            "group": "rating"
          }
        ],
        "summary": "Pilot {Un}V",
        "svg": [
          "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 18 90\" width=\"18\" height=\"90\">",
          "  <!--",
          "    Layer conventions (see docs/equipment-assets.md):",
          "      data-scope=\"pole\"    drawn once per pole, tile is the viewBox",
          "      data-scope=\"device\"  drawn once (default)",
          "      data-stretch=\"x\"     device layer scaled horizontally over all poles (use fills only)",
          "      data-show=\"...\"      visibility expression, e.g. on,!tripped  pole-n  kind==lamp",
          "      data-center-x=\"true\" text centred across the whole device",
          "      data-terminal=\"...\"  connection point (top/bottom per pole, or a name for device terminals)",
          "      {{token}}            replaced by parameters, e.g. {{In}} {{curve}} {{Icn#label}} {{color#hex}}",
          "  -->",
          "  <g data-scope=\"pole\" data-layer=\"body\">",
          "    <rect x=\"0.3\" y=\"0.3\" width=\"17.4\" height=\"89.4\" rx=\"1.6\" fill=\"#eceff3\" stroke=\"#69747f\" stroke-width=\"0.6\"/>",
          "    <rect x=\"1.6\" y=\"1.6\" width=\"14.8\" height=\"12\" rx=\"1\" fill=\"#d3d9e0\"/>",
          "    <rect x=\"1.6\" y=\"76.4\" width=\"14.8\" height=\"12\" rx=\"1\" fill=\"#d3d9e0\"/>",
          "    <circle data-terminal=\"top\" cx=\"9\" cy=\"7.6\" r=\"3\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M7.2 7.6h3.5999999999999996\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "    <circle data-terminal=\"bottom\" cx=\"9\" cy=\"82.4\" r=\"3\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M7.2 82.4h3.5999999999999996\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "  </g>",
          "  <g data-scope=\"pole\" data-layer=\"lens-ring\"><circle cx=\"9\" cy=\"45\" r=\"7.2\" fill=\"#c9d0d8\" stroke=\"#69747f\" stroke-width=\"0.5\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"lens-off\" data-show=\"!pole-lit\"><circle cx=\"9\" cy=\"45\" r=\"5.6\" fill=\"{{color#hex}}\" fill-opacity=\"0.35\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"lens-lit\" data-show=\"pole-lit\"><circle cx=\"9\" cy=\"45\" r=\"10\" fill=\"{{color#hex}}\" fill-opacity=\"0.25\"/><circle cx=\"9\" cy=\"45\" r=\"5.6\" fill=\"{{color#hex}}\"/><circle cx=\"7.2\" cy=\"43\" r=\"1.6\" fill=\"#ffffff\" fill-opacity=\"0.7\"/></g>",
          "  <g data-layer=\"labels\">",
          "    <text data-center-x=\"true\" x=\"0\" y=\"66\" font-size=\"3.2\" fill=\"#59636e\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">{{Un}} V</text>",
          "  </g>",
          "</svg>"
        ]
      }
    }
  ]
}
