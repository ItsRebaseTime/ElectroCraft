{
  "format": "electrocraft-modules",
  "version": 1,
  "modules": [
    {
      "id": "rcbo",
      "name": "RCBO (breaker + RCD)",
      "description": "Combined overcurrent and residual-current protection in 1 or 2 modules.",
      "designation": "F",
      "device": {
        "category": "protection",
        "role": "protection",
        "icon": "rcd",
        "mount": "din",
        "poleMode": "config",
        "poleConfigs": [
          "1P+N",
          "3P+N",
          "2P"
        ],
        "params": [
          {
            "key": "In",
            "label": "Rated current",
            "type": "select",
            "options": [
              {
                "value": 6,
                "label": "6 A"
              },
              {
                "value": 10,
                "label": "10 A"
              },
              {
                "value": 13,
                "label": "13 A"
              },
              {
                "value": 16,
                "label": "16 A"
              },
              {
                "value": 20,
                "label": "20 A"
              },
              {
                "value": 25,
                "label": "25 A"
              },
              {
                "value": 32,
                "label": "32 A"
              },
              {
                "value": 40,
                "label": "40 A"
              }
            ],
            "default": 16,
            "group": "rating"
          },
          {
            "key": "curve",
            "label": "Trip curve",
            "type": "select",
            "options": [
              "B",
              "C",
              "D"
            ],
            "default": "B",
            "group": "rating"
          },
          {
            "key": "IdN",
            "label": "Sensitivity",
            "type": "select",
            "options": [
              {
                "value": 10,
                "label": "10 mA"
              },
              {
                "value": 30,
                "label": "30 mA"
              },
              {
                "value": 100,
                "label": "100 mA"
              },
              {
                "value": 300,
                "label": "300 mA"
              }
            ],
            "default": 30,
            "group": "rating"
          },
          {
            "key": "type",
            "label": "Type",
            "type": "select",
            "options": [
              "AC",
              "A",
              "F",
              "B"
            ],
            "default": "A",
            "group": "rating"
          },
          {
            "key": "Icn",
            "label": "Breaking capacity",
            "type": "select",
            "options": [
              {
                "value": 3000,
                "label": "3 kA"
              },
              {
                "value": 4500,
                "label": "4.5 kA"
              },
              {
                "value": 6000,
                "label": "6 kA"
              },
              {
                "value": 10000,
                "label": "10 kA"
              }
            ],
            "default": 6000,
            "group": "rating"
          },
          {
            "key": "Un",
            "label": "Rated voltage",
            "type": "select",
            "options": [
              230,
              400
            ],
            "default": 230,
            "unit": "V",
            "group": "rating"
          }
        ],
        "stateful": true,
        "tripsOnOverload": true,
        "summary": "{curve}{In}/{IdN}mA {type}",
        "svg": [
          "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 9 90\" width=\"9\" height=\"90\">",
          "  <!--",
          "    Layer conventions (see docs/equipment-assets.md):",
          "      data-scope=\"pole\"    drawn once per pole, tile is the viewBox",
          "      data-scope=\"device\"  drawn once (default)",
          "      data-stretch=\"x\"     device layer scaled horizontally over all poles (use fills only)",
          "      data-show=\"...\"      visibility expression, e.g. on,!tripped  pole-n  kind==lamp",
          "      data-center-x=\"true\" text centred across the whole device",
          "      data-terminal=\"...\"  connection point (top/bottom per pole, or a name for device terminals)",
          "      {{token}}            replaced by parameters, e.g. {{In}} {{curve}} {{Icn#label}} {{color#hex}}",
          "  -->",
          "  <g data-scope=\"pole\" data-layer=\"body\">",
          "    <rect x=\"0.3\" y=\"0.3\" width=\"8.4\" height=\"89.4\" rx=\"1.6\" fill=\"#edf1ee\" stroke=\"#69747f\" stroke-width=\"0.6\"/>",
          "    <rect x=\"0.9\" y=\"0.9\" width=\"7.2\" height=\"12\" rx=\"1\" fill=\"#d3d9e0\"/>",
          "    <rect x=\"0.9\" y=\"77.1\" width=\"7.2\" height=\"12\" rx=\"1\" fill=\"#d3d9e0\"/>",
          "    <circle data-terminal=\"top\" cx=\"4.5\" cy=\"7.6\" r=\"2.2\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M3.1799999999999997 7.6h2.64\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "    <circle data-terminal=\"bottom\" cx=\"4.5\" cy=\"82.4\" r=\"2.2\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M3.1799999999999997 82.4h2.64\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "  </g>",
          "  <g data-scope=\"pole\" data-layer=\"neutral-tag\" data-show=\"pole-n\"><rect x=\"0.9\" y=\"15\" width=\"7.2\" height=\"4\" rx=\"0.8\" fill=\"#1f6fd1\"/></g>",
          "  <g data-layer=\"label-plate\" data-stretch=\"x\"><rect x=\"0.9\" y=\"20\" width=\"7.2\" height=\"54\" fill=\"#edf1ee\"/></g>",
          "  <g data-layer=\"window\" data-stretch=\"x\"><rect x=\"0.9\" y=\"33\" width=\"7.2\" height=\"25\" rx=\"1.2\" fill=\"#c9d0d8\"/></g>",
          "  <g data-layer=\"lever-on\" data-stretch=\"x\" data-show=\"on,!tripped\"><rect x=\"1.5\" y=\"34.5\" width=\"6\" height=\"11.5\" rx=\"1\" fill=\"#2d343c\"/></g>",
          "  <g data-layer=\"lever-off\" data-stretch=\"x\" data-show=\"!on,!tripped\"><rect x=\"1.5\" y=\"45\" width=\"6\" height=\"11.5\" rx=\"1\" fill=\"#2d343c\"/></g>",
          "  <g data-layer=\"lever-tripped\" data-stretch=\"x\" data-show=\"tripped\"><rect x=\"1.5\" y=\"39.8\" width=\"6\" height=\"11.5\" rx=\"1\" fill=\"#2d343c\"/><rect x=\"1.5\" y=\"55\" width=\"6\" height=\"2\" fill=\"#f08a24\"/></g>",
          "  <g data-layer=\"labels\">",
          "    <text data-center-x=\"true\" x=\"0\" y=\"24\" font-size=\"4.4\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">{{curve}}{{In}}</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"28.5\" font-size=\"3.2\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">{{IdN}}mA</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"63\" font-size=\"3.2\" fill=\"#59636e\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">{{type}}</text>",
          "  </g>",
          "  <g data-layer=\"test-button\"><rect x=\"1.5\" y=\"69\" width=\"6\" height=\"3.6\" rx=\"0.8\" fill=\"#1f6fd1\"/></g>",
          "</svg>"
        ]
      }
    }
  ]
}
