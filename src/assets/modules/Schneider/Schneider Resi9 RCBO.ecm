{
  "format": "electrocraft-modules",
  "version": 1,
  "modules": [
    {
      "id": "schneider-resi9-rcbo",
      "name": "Schneider Resi9 RCBO (R9D)",
      "description": "Resi9 RCBO 1P+N, 6 to 50 A (no 13 or 25 A), curve B, 30 mA type A, 6 kA, 18 mm wide. R9D87806 to R9D87850.",
      "designation": "F",
      "device": {
        "category": "library",
        "role": "protection",
        "icon": "rcd",
        "mount": "din",
        "poleMode": "config",
        "poleConfigs": [
          "1P+N"
        ],
        "params": [
          {
            "key": "In",
            "label": "Rated current",
            "type": "select",
            "options": [
              {
                "value": 6,
                "label": "6 A"
              },
              {
                "value": 10,
                "label": "10 A"
              },
              {
                "value": 16,
                "label": "16 A"
              },
              {
                "value": 20,
                "label": "20 A"
              },
              {
                "value": 32,
                "label": "32 A"
              },
              {
                "value": 40,
                "label": "40 A"
              },
              {
                "value": 50,
                "label": "50 A"
              }
            ],
            "default": 16,
            "group": "rating"
          },
          {
            "key": "curve",
            "label": "Trip curve",
            "type": "select",
            "options": [
              "B"
            ],
            "default": "B",
            "group": "rating"
          },
          {
            "key": "IdN",
            "label": "Sensitivity",
            "type": "select",
            "options": [
              {
                "value": 30,
                "label": "30 mA"
              }
            ],
            "default": 30,
            "group": "rating"
          },
          {
            "key": "type",
            "label": "Type",
            "type": "select",
            "options": [
              "A"
            ],
            "default": "A",
            "group": "rating"
          },
          {
            "key": "Icn",
            "label": "Breaking capacity",
            "type": "select",
            "options": [
              {
                "value": 6000,
                "label": "6 kA"
              }
            ],
            "default": 6000,
            "group": "rating"
          },
          {
            "key": "Un",
            "label": "Rated voltage",
            "type": "select",
            "options": [
              230
            ],
            "default": 230,
            "unit": "V",
            "group": "rating"
          }
        ],
        "stateful": true,
        "tripsOnOverload": true,
        "summary": "{curve}{In}/{IdN}mA {type}",
        "svg": [
          "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 9 90\" width=\"9\" height=\"90\">",
          "  <!--",
          "    Layer conventions (see docs/equipment-assets.md):",
          "      data-scope=\"pole\"    drawn once per pole, tile is the viewBox",
          "      data-scope=\"device\"  drawn once (default)",
          "      data-stretch=\"x\"     device layer scaled horizontally over all poles (use fills only)",
          "      data-show=\"...\"      visibility expression, e.g. on,!tripped  pole-n  kind==lamp",
          "      data-center-x=\"true\" text centred across the whole device",
          "      data-terminal=\"...\"  connection point (top/bottom per pole, or a name for device terminals)",
          "      {{token}}            replaced by parameters, e.g. {{In}} {{curve}} {{Icn#label}} {{color#hex}}",
          "  -->",
          "  <g data-scope=\"pole\" data-layer=\"frame-single\" data-show=\"pole-first,pole-last\"><rect x=\"0.3\" y=\"0.3\" width=\"8.4\" height=\"89.4\" rx=\"1.6\" fill=\"#f4f5f6\" stroke=\"#69747f\" stroke-width=\"0.6\"/><rect x=\"0.9\" y=\"0.9\" width=\"7.2\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/><rect x=\"0.9\" y=\"77.1\" width=\"7.2\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"frame-first\" data-show=\"pole-first,!pole-last\"><path d=\"M9 0.3H1.9A1.6 1.6 0 0 0 0.3 1.9V88.1A1.6 1.6 0 0 0 1.9 89.7H9Z\" fill=\"#f4f5f6\"/><rect x=\"0.9\" y=\"0.9\" width=\"9.1\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/><rect x=\"0.9\" y=\"77.1\" width=\"9.1\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/><path d=\"M9 0.3H1.9A1.6 1.6 0 0 0 0.3 1.9V88.1A1.6 1.6 0 0 0 1.9 89.7H9\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"frame-middle\" data-show=\"!pole-first,!pole-last\"><rect x=\"0\" y=\"0.3\" width=\"9\" height=\"89.4\" fill=\"#f4f5f6\"/><rect x=\"-1\" y=\"0.9\" width=\"11\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/><rect x=\"-1\" y=\"77.1\" width=\"11\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/><path d=\"M0 0.3H9M0 89.7H9\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"frame-last\" data-show=\"!pole-first,pole-last\"><path d=\"M0 0.3H7.1A1.6 1.6 0 0 1 8.7 1.9V88.1A1.6 1.6 0 0 1 7.1 89.7H0Z\" fill=\"#f4f5f6\"/><rect x=\"-1\" y=\"0.9\" width=\"9.1\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/><rect x=\"-1\" y=\"77.1\" width=\"9.1\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/><path d=\"M0 0.3H7.1A1.6 1.6 0 0 1 8.7 1.9V88.1A1.6 1.6 0 0 1 7.1 89.7H0\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"body\">",
          "    <circle data-terminal=\"top\" cx=\"4.5\" cy=\"7.6\" r=\"2.2\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M3.1799999999999997 7.6h2.64\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "    <circle data-terminal=\"bottom\" cx=\"4.5\" cy=\"82.4\" r=\"2.2\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M3.1799999999999997 82.4h2.64\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "  </g>",
          "  <g data-scope=\"pole\" data-layer=\"neutral-tag\" data-show=\"pole-n\"><rect x=\"0.9\" y=\"15\" width=\"7.2\" height=\"4\" rx=\"0.8\" fill=\"#1f6fd1\"/></g>",
          "  <g data-layer=\"label-plate\" data-stretch=\"x\"><rect x=\"0.9\" y=\"20\" width=\"7.2\" height=\"54\" fill=\"#f4f5f6\"/></g>",
          "  <g data-layer=\"window\" data-stretch=\"x\"><rect x=\"0.9\" y=\"33\" width=\"7.2\" height=\"25\" rx=\"1.2\" fill=\"#e3e5e7\"/></g>",
          "  <g data-layer=\"lever-on\" data-stretch=\"x\" data-show=\"on,!tripped\"><rect x=\"1.5\" y=\"34.5\" width=\"6\" height=\"11.5\" rx=\"1\" fill=\"#4a4c50\"/></g>",
          "  <g data-layer=\"lever-off\" data-stretch=\"x\" data-show=\"!on,!tripped\"><rect x=\"1.5\" y=\"45\" width=\"6\" height=\"11.5\" rx=\"1\" fill=\"#4a4c50\"/></g>",
          "  <g data-layer=\"lever-tripped\" data-stretch=\"x\" data-show=\"tripped\"><rect x=\"1.5\" y=\"39.8\" width=\"6\" height=\"11.5\" rx=\"1\" fill=\"#4a4c50\"/><rect x=\"1.5\" y=\"55\" width=\"6\" height=\"2\" fill=\"#f08a24\"/></g>",
          "  <g data-layer=\"labels\">",
          "    <text data-center-x=\"true\" x=\"0\" y=\"67\" font-size=\"2.2\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">Resi9</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"19.2\" font-size=\"1.9\" fill=\"#00873c\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">Schneider</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"24\" font-size=\"4.4\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">{{curve}}{{In}}</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"28.5\" font-size=\"3.2\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">{{IdN}}mA</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"63\" font-size=\"3.2\" fill=\"#59636e\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">{{type}}</text>",
          "  </g>",
          "  <g data-layer=\"test-button\"><rect x=\"1.5\" y=\"69\" width=\"6\" height=\"3.6\" rx=\"0.8\" fill=\"#4a4c50\"/></g>",
          "</svg>"
        ]
      }
    }
  ]
}
