{
  "format": "electrocraft-modules",
  "version": 1,
  "modules": [
    {
      "id": "schneider-resi9-rccb",
      "name": "Schneider Resi9 RCCB (R9R)",
      "description": "Resi9 residual current circuit breaker 2P, 63 or 100 A, 30 mA, or 100 A 300 mA time delayed (TD), type AC, 36 mm wide. R9R81263, R9R81291, R9R85291.",
      "designation": "F",
      "device": {
        "category": "library",
        "role": "protection",
        "icon": "rcd",
        "mount": "din",
        "poleMode": "config",
        "poleConfigs": [
          "2P"
        ],
        "params": [
          {
            "key": "In",
            "label": "Rated current",
            "type": "select",
            "options": [
              {
                "value": 63,
                "label": "63 A"
              },
              {
                "value": 100,
                "label": "100 A"
              }
            ],
            "default": 63,
            "group": "rating"
          },
          {
            "key": "IdN",
            "label": "Sensitivity",
            "type": "select",
            "options": [
              {
                "value": 30,
                "label": "30 mA"
              },
              {
                "value": 300,
                "label": "300 mA"
              }
            ],
            "default": 30,
            "group": "rating"
          },
          {
            "key": "type",
            "label": "Type",
            "type": "select",
            "options": [
              "AC"
            ],
            "default": "AC",
            "group": "rating"
          },
          {
            "key": "Un",
            "label": "Rated voltage",
            "type": "select",
            "options": [
              230
            ],
            "default": 230,
            "unit": "V",
            "group": "rating"
          }
        ],
        "stateful": true,
        "tripsOnOverload": true,
        "summary": "{In}A/{IdN}mA {type}",
        "svg": [
          "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 18 90\" width=\"18\" height=\"90\">",
          "  <!--",
          "    Layer conventions (see docs/equipment-assets.md):",
          "      data-scope=\"pole\"    drawn once per pole, tile is the viewBox",
          "      data-scope=\"device\"  drawn once (default)",
          "      data-stretch=\"x\"     device layer scaled horizontally over all poles (use fills only)",
          "      data-show=\"...\"      visibility expression, e.g. on,!tripped  pole-n  kind==lamp",
          "      data-center-x=\"true\" text centred across the whole device",
          "      data-terminal=\"...\"  connection point (top/bottom per pole, or a name for device terminals)",
          "      {{token}}            replaced by parameters, e.g. {{In}} {{curve}} {{Icn#label}} {{color#hex}}",
          "  -->",
          "  <g data-scope=\"pole\" data-layer=\"frame-single\" data-show=\"pole-first,pole-last\"><rect x=\"0.3\" y=\"0.3\" width=\"17.4\" height=\"89.4\" rx=\"1.6\" fill=\"#f4f5f6\" stroke=\"#69747f\" stroke-width=\"0.6\"/><rect x=\"1.6\" y=\"1.6\" width=\"14.8\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/><rect x=\"1.6\" y=\"76.4\" width=\"14.8\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"frame-first\" data-show=\"pole-first,!pole-last\"><path d=\"M18 0.3H1.9A1.6 1.6 0 0 0 0.3 1.9V88.1A1.6 1.6 0 0 0 1.9 89.7H18Z\" fill=\"#f4f5f6\"/><rect x=\"1.6\" y=\"1.6\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/><rect x=\"1.6\" y=\"76.4\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/><path d=\"M18 0.3H1.9A1.6 1.6 0 0 0 0.3 1.9V88.1A1.6 1.6 0 0 0 1.9 89.7H18\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"frame-middle\" data-show=\"!pole-first,!pole-last\"><rect x=\"0\" y=\"0.3\" width=\"18\" height=\"89.4\" fill=\"#f4f5f6\"/><rect x=\"-1\" y=\"1.6\" width=\"20\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/><rect x=\"-1\" y=\"76.4\" width=\"20\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/><path d=\"M0 0.3H18M0 89.7H18\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"frame-last\" data-show=\"!pole-first,pole-last\"><path d=\"M0 0.3H16.1A1.6 1.6 0 0 1 17.7 1.9V88.1A1.6 1.6 0 0 1 16.1 89.7H0Z\" fill=\"#f4f5f6\"/><rect x=\"-1\" y=\"1.6\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/><rect x=\"-1\" y=\"76.4\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#e9ebed\"/><path d=\"M0 0.3H16.1A1.6 1.6 0 0 1 17.7 1.9V88.1A1.6 1.6 0 0 1 16.1 89.7H0\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"body\">",
          "    <circle data-terminal=\"top\" cx=\"9\" cy=\"7.6\" r=\"3\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M7.2 7.6h3.5999999999999996\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "    <circle data-terminal=\"bottom\" cx=\"9\" cy=\"82.4\" r=\"3\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M7.2 82.4h3.5999999999999996\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "  </g>",
          "  <g data-scope=\"pole\" data-layer=\"neutral-tag\" data-show=\"pole-n\">",
          "    <rect x=\"1.6\" y=\"15\" width=\"14.8\" height=\"4\" rx=\"0.8\" fill=\"#1f6fd1\"/>",
          "    <text x=\"9\" y=\"18\" font-size=\"3.2\" fill=\"#ffffff\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">N</text>",
          "  </g>",
          "  <g data-layer=\"label-plate\" data-stretch=\"x\"><rect x=\"1.8\" y=\"20\" width=\"14.4\" height=\"54\" fill=\"#f4f5f6\"/></g>",
          "  <g data-layer=\"window\" data-stretch=\"x\"><rect x=\"1.8\" y=\"33\" width=\"14.4\" height=\"25\" rx=\"1.2\" fill=\"#e3e5e7\"/></g>",
          "  <g data-layer=\"lever-on\" data-stretch=\"x\" data-show=\"on,!tripped\"><rect x=\"3\" y=\"34.5\" width=\"12\" height=\"11.5\" rx=\"1\" fill=\"#4a4c50\"/><rect x=\"3\" y=\"34.5\" width=\"12\" height=\"2\" rx=\"1\" fill=\"#5b6672\"/></g>",
          "  <g data-layer=\"lever-off\" data-stretch=\"x\" data-show=\"!on,!tripped\"><rect x=\"3\" y=\"45\" width=\"12\" height=\"11.5\" rx=\"1\" fill=\"#4a4c50\"/><rect x=\"3\" y=\"54.5\" width=\"12\" height=\"2\" rx=\"1\" fill=\"#5b6672\"/></g>",
          "  <g data-layer=\"lever-tripped\" data-stretch=\"x\" data-show=\"tripped\"><rect x=\"3\" y=\"39.8\" width=\"12\" height=\"11.5\" rx=\"1\" fill=\"#4a4c50\"/><rect x=\"3\" y=\"55\" width=\"12\" height=\"2\" fill=\"#f08a24\"/></g>",
          "  <g data-layer=\"labels\">",
          "    <text data-center-x=\"true\" x=\"0\" y=\"69\" font-size=\"2.6\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">Resi9</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"19.2\" font-size=\"1.9\" fill=\"#00873c\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">Schneider</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"25\" font-size=\"4.6\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">{{In}}A</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"30\" font-size=\"3.6\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">{{IdN}} mA</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"63\" font-size=\"3.2\" fill=\"#59636e\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">Type {{type}}</text>",
          "  </g>",
          "  <g data-layer=\"test-button\"><rect x=\"3.5\" y=\"70\" width=\"11\" height=\"4.2\" rx=\"1\" fill=\"#4a4c50\"/><text x=\"9\" y=\"73.2\" font-size=\"2.8\" fill=\"#fff\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">T</text></g>",
          "</svg>"
        ]
      }
    }
  ]
}
