          "  <g data-scope=\"pole\" data-layer=\"frame-first\" data-show=\"pole-first,!pole-last\"><path d=\"M18 0.3H1.9A1.6 1.6 0 0 0 0.3 1.9V88.1A1.6 1.6 0 0 0 1.9 89.7H18Z\" fill=\"#d4d6d8\"/><rect x=\"1.6\" y=\"1.6\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#c3c6c9\"/><rect x=\"1.6\" y=\"76.4\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#c3c6c9\"/><path d=\"M18 0.3H1.9A1.6 1.6 0 0 0 0.3 1.9V88.1A1.6 1.6 0 0 0 1.9 89.7H18\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"frame-middle\" data-show=\"!pole-first,!pole-last\"><rect x=\"0\" y=\"0.3\" width=\"18\" height=\"89.4\" fill=\"#d4d6d8\"/><rect x=\"-1\" y=\"1.6\" width=\"20\" height=\"12\" rx=\"1\" fill=\"#c3c6c9\"/><rect x=\"-1\" y=\"76.4\" width=\"20\" height=\"12\" rx=\"1\" fill=\"#c3c6c9\"/><path d=\"M0 0.3H18M0 89.7H18\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"frame-last\" data-show=\"!pole-first,pole-last\"><path d=\"M0 0.3H16.1A1.6 1.6 0 0 1 17.7 1.9V88.1A1.6 1.6 0 0 1 16.1 89.7H0Z\" fill=\"#d4d6d8\"/><rect x=\"-1\" y=\"1.6\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#c3c6c9\"/><rect x=\"-1\" y=\"76.4\" width=\"17.4\" height=\"12\" rx=\"1\" fill=\"#c3c6c9\"/><path d=\"M0 0.3H16.1A1.6 1.6 0 0 1 17.7 1.9V88.1A1.6 1.6 0 0 1 16.1 89.7H0\" fill=\"none\" stroke=\"#69747f\" stroke-width=\"0.6\" stroke-linejoin=\"round\" stroke-linecap=\"butt\"/></g>",
          "  <g data-scope=\"pole\" data-layer=\"body\">",
          "    <circle data-terminal=\"top\" cx=\"9\" cy=\"7.6\" r=\"3\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M7.2 7.6h3.5999999999999996\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "    <circle data-terminal=\"bottom\" cx=\"9\" cy=\"82.4\" r=\"3\" fill=\"#9aa4af\" stroke=\"#4c5560\" stroke-width=\"0.5\"/><path d=\"M7.2 82.4h3.5999999999999996\" stroke=\"#3b444d\" stroke-width=\"0.7\"/>",
          "  </g>",
          "  <g data-scope=\"pole\" data-layer=\"neutral-tag\" data-show=\"pole-n\">",
          "    <rect x=\"1.6\" y=\"15\" width=\"14.8\" height=\"4\" rx=\"0.8\" fill=\"#1f6fd1\"/>",
          "    <text x=\"9\" y=\"18\" font-size=\"3.2\" fill=\"#ffffff\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">N</text>",
          "  </g>",
          "  <g data-layer=\"label-plate\" data-stretch=\"x\"><rect x=\"1.8\" y=\"20\" width=\"14.4\" height=\"54\" fill=\"#d4d6d8\"/></g>",
          "  <g data-layer=\"window\" data-stretch=\"x\"><rect x=\"1.8\" y=\"30\" width=\"14.4\" height=\"32\" rx=\"1.2\" fill=\"#c1c4c7\"/></g>",
          "  <g data-layer=\"lever-on\" data-stretch=\"x\" data-show=\"on\"><rect x=\"3\" y=\"49\" width=\"12\" height=\"14.5\" rx=\"1\" fill=\"#c0261c\"/><rect x=\"3\" y=\"49\" width=\"12\" height=\"2\" fill=\"#e5645b\"/></g>",
          "  <g data-layer=\"lever-off\" data-stretch=\"x\" data-show=\"!on\"><rect x=\"3\" y=\"58\" width=\"12\" height=\"14.5\" rx=\"1\" fill=\"#4a4c50\"/><rect x=\"3\" y=\"70.5\" width=\"12\" height=\"2\" fill=\"#5b6672\"/></g>",
          "  <g data-layer=\"labels\">",
          "    <text data-center-x=\"true\" x=\"0\" y=\"31\" font-size=\"2.6\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">Easy9</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"19.2\" font-size=\"1.9\" fill=\"#00873c\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">Schneider</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"24\" font-size=\"4.6\" fill=\"#1f2630\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\" font-weight=\"bold\">{{In}}A</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"40\" font-size=\"3.4\" fill=\"#59636e\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">I-O</text>",
          "    <text data-center-x=\"true\" x=\"0\" y=\"44\" font-size=\"3\" fill=\"#59636e\" text-anchor=\"middle\" font-family=\"Helvetica, Arial, sans-serif\">{{Un}} V</text>",
          "  </g>",
          "</svg>"
        ]
      }
    }
  ]
