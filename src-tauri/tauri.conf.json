{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ElectroCraft",
  "version": "0.1.0",
  "identifier": "app.electrocraft.planner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ElectroCraft",
        "width": 1500,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "European electrical panel planner",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
